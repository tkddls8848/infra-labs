# 텍스트 파일은 LF로 통일 (Windows에서 CRLF 자동 변환 방지)
* text=auto eol=lf

*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.tf   text eol=lf
*.tfvars text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.env  text eol=lf

# 바이너리는 변환 제외
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pem binary
