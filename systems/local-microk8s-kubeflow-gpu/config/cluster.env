# Single source of cluster settings for scripts/cluster/03_* and 04_*.
# This file is sourced by Bash; keep values quoted and do not add commands.
MICROK8S_CHANNEL="1.32/stable"
METALLB_RANGE="172.30.1.240-172.30.1.250"
JUJU_CHANNEL="3.6/stable"
KUBEFLOW_CHANNEL="1.10/stable"
KUBEFLOW_PORT="1234"

# Lab-only dashboard identity. Leave the password empty to generate a new
# random value during installation. For a stable credential, copy this file to
# an untracked location, set the password there, and pass CLUSTER_CONFIG=/path.
KUBEFLOW_USERNAME="admin"
KUBEFLOW_PASSWORD=""
