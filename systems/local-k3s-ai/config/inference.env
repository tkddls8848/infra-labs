# ─────────────────────────────────────────────────────────────────────────────
# local-k3s-ai 추론 랩의 단일 설정 원천.
#
# 이 파일은 Bash 로 source 된다. 명령을 넣지 말고 값만 따옴표로 적는다.
# scripts/inference/*.sh 와 bench/*.py 가 모두 이 값을 읽는다. 스크립트 안에
# 같은 값을 다시 적지 않는다 — 두 번째 목록이 생기는 순간 서로 어긋난다.
#
# 버전들은 '세트' 다. llm-d v0.9.0 가이드가 GAIE v1.5.0 과 라우터 차트 v0.10.0
# 을 가리키고, 차트 preset 이 Envoy 태그를 고정한다. 하나만 올리지 말고 아래
# 검증 절차(README 의 "버전 갱신")를 따라 함께 올린다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 네임스페이스 ─────────────────────────────────────────────────────────────
NAMESPACE="llm-d-lab"
RELEASE_NAME="llmd-lab"

# ── 상류 버전 핀 ─────────────────────────────────────────────────────────────
# Gateway API Inference Extension: InferencePool CRD 제공.
GAIE_VERSION="v1.5.0"
GAIE_MANIFEST_URL="https://github.com/kubernetes-sigs/gateway-api-inference-extension/releases/download/${GAIE_VERSION}/v1-manifests.yaml"
GAIE_MANIFEST_SHA256="cd7cc63149943627f92d401991886a631d938de28edb416312c443a1b7f42ded"

# llm-d 라우터 Helm 차트 (standalone = EPP + Envoy 사이드카, Gateway 프로바이더 불필요).
# CHART_SHA256 은 OCI 레이어 다이제스트이자 helm pull 이 내려받는 .tgz 의 sha256 이다.
ROUTER_CHART="oci://ghcr.io/llm-d/charts/llm-d-router-standalone"
ROUTER_CHART_VERSION="v0.10.0"
ROUTER_CHART_SHA256="9e712f0c47eca34d71f58a327237e9f23c407345a84d03ba9dc91cb4fff98dbf"

# EPP 이미지. 차트 기본값은 움직이는 `main` 태그라 재현되지 않는다. 릴리스 태그로 고정한다.
ROUTER_EPP_IMAGE_REGISTRY="ghcr.io/llm-d"
ROUTER_EPP_IMAGE_REPOSITORY="llm-d-router-endpoint-picker"
ROUTER_EPP_IMAGE_TAG="v0.10.0"

# llm-d 상류 저장소. 07_pd_anatomy.sh 가 이 태그를 그대로 체크아웃해
# Prefill/Decode 분리 매니페스트를 렌더해 읽는다 (적용하지는 않는다).
LLMD_REPO_URL="https://github.com/llm-d/llm-d.git"
LLMD_VERSION="v0.9.0"

# ── 모델 서버 ────────────────────────────────────────────────────────────────
# 기본값은 실습용 최소 크기다 — 소비자용 GPU 1장(VRAM 6 GiB)과 RAM 16 GiB
# 워크스테이션에서 끝까지 돌아가는 선이자, 랩의 전제("요청이 여러 파드로
# 흩어진다")가 성립하는 하한이다. 더 큰 GPU 로 옮기면 REPLICAS 와
# GPU_MEMORY_UTILIZATION 을 함께 올린다 (README 의 "GPU 메모리 산정" 표).
VLLM_IMAGE="docker.io/vllm/vllm-openai:v0.26.0"
MODEL_ID="Qwen/Qwen2.5-0.5B-Instruct"
MODEL_LABEL="qwen2-5-0-5b-instruct"
# 2 가 하한이다. 1 이면 비교 대상인 '분산' 자체가 사라진다.
REPLICAS="2"
MAX_MODEL_LEN="8192"

# 동시에 스케줄할 시퀀스 수. 상류 기본값은 이 랩의 부하(동시 4)에 비해 훨씬
# 크고, 그만큼 스케줄러 자료구조와 CPU 메모리를 미리 잡는다.
MAX_NUM_SEQS="32"

# 가중치 캐시 PVC 크기. Qwen2.5-0.5B 가중치는 1 GiB 남짓이라 모델을 한두 개 더
# 받아 볼 만큼만 잡는다. K3s local-path 는 hostPath 라 이 숫자로 용량을 강제하지
# 않지만, 다른 스토리지 클래스로 옮기면 그대로 요구되므로 사실에 맞춰 적는다.
MODEL_CACHE_SIZE="10Gi"

# /dev/shm. 텐서 병렬(TP>1)에서 워커 사이 통신에 쓰인다. 이 랩은 TP=1 이라
# 거의 쓰지 않는다. tmpfs 페이지는 파드 메모리로 계산되므로 작게 둔다.
SHM_SIZE="512Mi"

# time-slicing 은 메모리를 나누지 않는다. 레플리카마다 전체 VRAM 의 이 비율을
# 잡으므로 REPLICAS * GPU_MEMORY_UTILIZATION < 0.95 여야 한다.
#
# 2 x 0.40 = 0.80. VRAM 6 GiB 기준 레플리카당 약 2.4 GiB 로, 가중치(약 1 GiB)를
# 빼고도 KV 캐시가 수만 토큰 남는다 — 이 랩의 접두사 1500 토큰짜리 대화에는
# 충분하고도 남는다. 남긴 0.20(약 1.2 GiB)은 데스크톱 화면이 이미 쓰고 있는
# 몫이다. 노트북 GPU 에서 이 여유를 없애면 첫 레플리카부터 CUDA OOM 이다.
GPU_MEMORY_UTILIZATION="0.40"

# ── GPU 공유 (NVIDIA device plugin time-slicing) ─────────────────────────────
DEVICE_PLUGIN_IMAGE="nvcr.io/nvidia/k8s-device-plugin:v0.17.0"
# 하나의 물리 GPU 를 몇 개의 nvidia.com/gpu 로 광고할지. REPLICAS 보다 커야
# EPP/벤치 파드가 아닌 모델 서버들이 전부 스케줄된다. 여유는 1개면 된다 —
# 숫자를 키운다고 GPU 가 커지지는 않고, 과하게 잡으면 스케줄러가 들어갈 수
# 없는 파드를 GPU 위에 올려 버린다.
GPU_TIME_SLICING_REPLICAS="3"

# ── EPP 라우팅 동작 (실습용 손잡이) ──────────────────────────────────────────
# prefix-cache-affinity-filter 는 엔드포인트가 '뜨거워지면' 캐시 친화도를 포기하고
# 부하를 흩뜨린다. 그 판단 기준이 아래 값(초당 prefill 토큰)이다. 15928 은 상류
# 기본값으로, Qwen3-32B / H100 80GB / TP=2 에서 측정된 수치다.
#
# 이 랩의 작은 모델과 소비자용 GPU 는 그 근처에도 못 가므로, 기본값을 두면 EPP 는
# 거의 항상 '한가하다'고 보고 캐시 친화도를 유지한다 — 실습 B 에서 보고 싶은 바로
# 그 동작이다. 실습 C 에서는 이 값을 확 낮춰서(예: 50) 포화 회피가 발동할 때
# 히트율이 어떻게 무너지는지 직접 보게 된다.
PEAK_PREFILL_THROUGHPUT="15928"

# EPP 로그 레벨. 4 이상이면 후보 엔드포인트와 점수가 로그에 남는다. 부하가 큰
# 환경에서는 비싸지만, 이 랩의 요청 수(수십 건)에서는 관찰용으로 켜 둘 만하다.
EPP_LOG_VERBOSITY="4"

# ── 리소스 (실습용 최소 크기) ──────────────────────────────────────
# 상류 guides 기본값은 EPP cpu=8/mem=8Gi, Envoy cpu=4/mem=8Gi 라서 로컬 단일
# 노드에서는 vLLM 과 CPU 를 두고 싸운다. 랩에서는 아래로 낮춘다.
#
# request 와 limit 을 다르게 잡은 데에는 이유가 있다. request 는 스케줄러가
# 자리를 잡을 때 쓰는 숫자라 작을수록 좋고, limit 은 OOMKill 선이라 넉넉해야
# 한다. 둘을 같이 줄이면 파드가 Pending 대신 CrashLoopBackOff 로 바뀔 뿐이다.
#
# 요청 합계: vLLM 2 x (cpu 1, 4Gi) + EPP 250m/256Mi + Envoy 250m/128Mi
#            = cpu 2.5, 메모리 약 8.4 GiB. RAM 16 GiB 노드에 K3s 몫을 남긴다.
EPP_CPU_REQUEST="250m"
EPP_MEMORY_REQUEST="256Mi"
EPP_MEMORY_LIMIT="1Gi"
PROXY_CPU_REQUEST="250m"
PROXY_MEMORY_REQUEST="128Mi"
PROXY_MEMORY_LIMIT="512Mi"

VLLM_CPU_REQUEST="1"
VLLM_MEMORY_REQUEST="4Gi"
VLLM_MEMORY_LIMIT="8Gi"

# ── 진입점 포트 (host 쪽 port-forward) ───────────────────────────────────────
# 04_observe 가 두 경로를 동시에 띄워 비교하므로 포트를 분리한다.
BASELINE_LOCAL_PORT="8000"
ROUTER_LOCAL_PORT="8081"

# ── HuggingFace ──────────────────────────────────────────────────────────────
# Qwen2.5-0.5B-Instruct 는 gated 모델이 아니라 토큰 없이도 받아진다. gated 모델로
# 바꾸면 export HF_TOKEN=... 후 02_modelserver_up.sh 를 다시 돌린다.
HF_TOKEN="${HF_TOKEN:-}"
