# -*- mode: ruby -*-
# vi: set ft=ruby :

CLUSTER_NAME = "hadoop-ubuntu2404"
HADOOP_VERSION = "3.5.0"

NODES = {
  "hadoop-worker1" => { ip: "192.168.70.21", cpus: 1, memory: 1536, role: "worker", ssh: 22101 },
  "hadoop-worker2" => { ip: "192.168.70.22", cpus: 1, memory: 1536, role: "worker", ssh: 22102 },
  "hadoop-master"  => { ip: "192.168.70.10", cpus: 2, memory: 2048, role: "master", ssh: 22100 }
}

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  NODES.each do |hostname, node|
    config.vm.define hostname do |cfg|
      cfg.vm.hostname = hostname
      cfg.vm.network "private_network", ip: node[:ip]
      cfg.vm.network "forwarded_port", guest: 22, host: node[:ssh], id: "ssh", auto_correct: true

      if node[:role] == "master"
        cfg.vm.network "forwarded_port", guest: 9870, host: 9870, auto_correct: true
        cfg.vm.network "forwarded_port", guest: 8088, host: 8088, auto_correct: true
      end

      cfg.vm.provider "virtualbox" do |vb|
        vb.name = hostname
        vb.gui = false
        vb.cpus = node[:cpus]
        vb.memory = node[:memory]
        vb.customize ["modifyvm", :id, "--groups", "/#{CLUSTER_NAME}"]
      end

      cfg.vm.provision "shell",
        path: "scripts/common.sh",
        args: [node[:role], HADOOP_VERSION],
        privileged: true

      if node[:role] == "master"
        cfg.vm.provision "shell",
          path: "scripts/init-master.sh",
          args: [HADOOP_VERSION],
          privileged: true,
          run: "always"
      end
    end
  end
end
